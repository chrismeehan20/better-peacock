{
  "parser": "@typescript-eslint/parser",
  "plugins": ["@typescript-eslint"],
  "extends": [
    "plugin:@typescript-eslint/recommended",
    // "prettier/@typescript-eslint" was merged into "prettier" in
    // eslint-config-prettier 8.0.0.
    "prettier"
    // Prettier is enforced by the `pretty` script and the pre-commit hook
    // rather than through ESLint, so eslint-plugin-prettier stays unused.
  ],
  "parserOptions": {
    "project": "./tsconfig.json"
  },
  "rules": {
    // Rules removed in @typescript-eslint v8 are intentionally absent:
    // no-parameter-properties, no-angle-bracket-type-assertion,
    // no-object-literal-type-assertion, interface-name-prefix, and camelcase.
    "@typescript-eslint/explicit-function-return-type": "off",
    "@typescript-eslint/no-use-before-define": "off",
    "@typescript-eslint/no-explicit-any": "off",
    "@typescript-eslint/no-non-null-assertion": "off",
    "@typescript-eslint/explicit-member-accessibility": "off"
  }
}
