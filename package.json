{
  "name": "better-peacock",
  "displayName": "Better Peacock",
  "description": "Automatically color-code VS Code workspaces by project, repository, and branch so every window is easy to identify.",
  "version": "4.2.5",
  "publisher": "chrismeehan20",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/chrismeehan20/better-peacock.git"
  },
  "homepage": "https://github.com/chrismeehan20/better-peacock#readme",
  "bugs": {
    "url": "https://github.com/chrismeehan20/better-peacock/issues"
  },
  "icon": "resources/peacock-icon.png",
  "galleryBanner": {
    "color": "#373436",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "Theme",
    "Colors",
    "Fun"
  ],
  "preview": false,
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "main": "./dist/extension-node.js",
  "browser": "./dist/extension-web.js",
  "contributes": {
    "commands": [
      {
        "command": "peacock.docs",
        "title": "Open the Documentation",
        "category": "Better Peacock"
      },
      {
        "command": "peacock.resetWorkspaceColors",
        "title": "Reset Workspace Colors",
        "category": "Better Peacock"
      },
      {
        "command": "peacock.removeAllColors",
        "title": "Remove All Global and Workspace Colors",
        "category": "Better Peacock"
      },
      {
        "command": "peacock.saveColorToFavorites",
        "title": "Save Current Color to Favorites",
        "category": "Better Peacock"
      },
      {
        "command": "peacock.enterColor",
        "title": "Enter a Color",
        "category": "Better Peacock"
      },
      {
        "command": "peacock.changeColorToPeacockGreen",
        "title": "Color to Peacock Green",
        "category": "Better Peacock"
      },
      {
        "command": "peacock.addRecommendedFavorites",
        "title": "Add the Recommended Favorites",
        "category": "Better Peacock"
      },
      {
        "command": "peacock.changeColorToRandom",
        "title": "Surprise Me with a Random Color",
        "category": "Better Peacock"
      },
      {
        "command": "peacock.changeColorToFavorite",
        "title": "Change to a Favorite Color",
        "category": "Better Peacock"
      },
      {
        "command": "peacock.darken",
        "title": "Darken",
        "category": "Better Peacock"
      },
      {
        "command": "peacock.lighten",
        "title": "Lighten",
        "category": "Better Peacock"
      },
      {
        "command": "peacock.showAndCopyCurrentColor",
        "title": "Copy the Current Color to the Clipboard",
        "category": "Better Peacock"
      },
      {
        "command": "peacock.enableAutomaticColor",
        "title": "Enable Automatic Workspace Color",
        "category": "Better Peacock"
      },
      {
        "command": "peacock.disableAutomaticColor",
        "title": "Disable Automatic Workspace Color",
        "category": "Better Peacock"
      },
      {
        "command": "peacock.refreshAutomaticColor",
        "title": "Refresh Automatic Workspace Color",
        "category": "Better Peacock"
      },
      {
        "command": "peacock.installAgentBeacon",
        "title": "Install Agent Beacon Hooks",
        "category": "Better Peacock"
      },
      {
        "command": "peacock.uninstallAgentBeacon",
        "title": "Uninstall Agent Beacon Hooks",
        "category": "Better Peacock"
      },
      {
        "command": "peacock.verifyAgentBeacon",
        "title": "Verify Agent Beacon Hooks",
        "category": "Better Peacock"
      },
      {
        "command": "peacock.showAttentionQueue",
        "title": "Show Attention Queue",
        "category": "Better Peacock",
        "icon": "$(list-unordered)"
      },
      {
        "command": "peacock.openAgentBeaconProject",
        "title": "Open Agent Beacon Project",
        "category": "Better Peacock"
      },
      {
        "command": "peacock.changeColorOfLiveShareHost",
        "title": "Change Live Share Color (Host)",
        "category": "Better Peacock"
      },
      {
        "command": "peacock.changeColorOfLiveShareGuest",
        "title": "Change Live Share Color (Guest)",
        "category": "Better Peacock"
      }
    ],
    "keybindings": [
      {
        "key": "alt+cmd+-",
        "command": "peacock.darken"
      },
      {
        "key": "alt+cmd+=",
        "command": "peacock.lighten"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "peacock.docs"
        },
        {
          "command": "peacock.changeColorOfLiveShareHost",
          "when": "workspaceFolderCount != 0 && peacock:liveshare == true"
        },
        {
          "command": "peacock.changeColorOfLiveShareGuest",
          "when": "workspaceFolderCount != 0 && peacock:liveshare == true"
        },
        {
          "command": "peacock.resetWorkspaceColors",
          "when": "workspaceFolderCount != 0"
        },
        {
          "command": "peacock.removeAllColors",
          "when": "workspaceFolderCount != 0"
        },
        {
          "command": "peacock.saveColorToFavorites",
          "when": "workspaceFolderCount != 0"
        },
        {
          "command": "peacock.enterColor",
          "when": "workspaceFolderCount != 0"
        },
        {
          "command": "peacock.changeColorToPeacockGreen",
          "when": "workspaceFolderCount != 0"
        },
        {
          "command": "peacock.addRecommendedFavorites",
          "when": "workspaceFolderCount != 0"
        },
        {
          "command": "peacock.changeColorToRandom",
          "when": "workspaceFolderCount != 0"
        },
        {
          "command": "peacock.changeColorToFavorite",
          "when": "workspaceFolderCount != 0"
        },
        {
          "command": "peacock.darken",
          "when": "workspaceFolderCount != 0"
        },
        {
          "command": "peacock.lighten",
          "when": "workspaceFolderCount != 0"
        },
        {
          "command": "peacock.showAndCopyCurrentColor",
          "when": "workspaceFolderCount != 0"
        },
        {
          "command": "peacock.enableAutomaticColor",
          "when": "workspaceFolderCount != 0"
        },
        {
          "command": "peacock.disableAutomaticColor",
          "when": "workspaceFolderCount != 0"
        },
        {
          "command": "peacock.refreshAutomaticColor",
          "when": "workspaceFolderCount != 0"
        },
        {
          "command": "peacock.installAgentBeacon"
        },
        {
          "command": "peacock.uninstallAgentBeacon"
        },
        {
          "command": "peacock.verifyAgentBeacon"
        },
        {
          "command": "peacock.showAttentionQueue"
        },
        {
          "command": "peacock.openAgentBeaconProject",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "peacock.verifyAgentBeacon",
          "when": "view == peacock.attentionQueue",
          "group": "navigation"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "peacock.attentionQueue",
          "name": "Agent Attention Queue",
          "when": "config.peacock.agentBeaconEnabled"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "peacock.attentionQueue",
        "contents": "No agents are reporting state yet.\n\nAgent Beacon reads lifecycle hooks from Codex and Claude Code. Install the hooks to start tracking which projects need input.\n\n[Install Agent Beacon Hooks](command:peacock.installAgentBeacon)\n\n[Verify Hooks](command:peacock.verifyAgentBeacon)"
      }
    ],
    "walkthroughs": [
      {
        "id": "peacock.agentBeacon",
        "title": "Track your background agents",
        "description": "Show which projects need your input across every VS Code window, driven by Codex and Claude Code lifecycle hooks.",
        "steps": [
          {
            "id": "peacock.agentBeacon.install",
            "title": "Install the hooks",
            "description": "Choose Codex, Claude Code, or both. Better Peacock backs up your existing hook files and merges its handlers alongside them, so your other hooks keep working.\n\n[Install Agent Beacon Hooks](command:peacock.installAgentBeacon)",
            "media": {
              "markdown": "resources/walkthrough/install.md"
            },
            "completionEvents": [
              "onSettingChanged:peacock.agentBeaconEnabled"
            ]
          },
          {
            "id": "peacock.agentBeacon.trust",
            "title": "Trust the hooks in Codex",
            "description": "Codex will not run a hook it has not been told to trust. Run /hooks in Codex, approve the Better Peacock entries, then verify.\n\n[Verify Agent Beacon Hooks](command:peacock.verifyAgentBeacon)",
            "media": {
              "markdown": "resources/walkthrough/trust.md"
            },
            "completionEvents": [
              "onCommand:peacock.verifyAgentBeacon"
            ]
          },
          {
            "id": "peacock.agentBeacon.queue",
            "title": "Watch the attention queue",
            "description": "The Agent Attention Queue appears in the Explorer sidebar and lists every project that needs input, is ready, or failed. Selecting a project opens it in a new window.\n\n[Show Attention Queue](command:peacock.showAttentionQueue)",
            "media": {
              "markdown": "resources/walkthrough/queue.md"
            },
            "completionEvents": [
              "onCommand:peacock.showAttentionQueue"
            ]
          }
        ]
      }
    ],
    "configurationDefaults": {
      "window.title": "${rootName} [VS Code]"
    },
    "configuration": {
      "properties": {
        "peacock.agentBeaconEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Shows Codex and Claude Code lifecycle states in the status bar and Attention Queue. Use the Install Agent Beacon Hooks command to configure supported hooks."
        },
        "peacock.agentBeaconNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Shows one VS Code notification when a background agent needs input, finishes, or fails. Notifications are suppressed while the window is focused."
        },
        "peacock.agentBeaconPollInterval": {
          "type": "number",
          "default": 1000,
          "minimum": 500,
          "maximum": 10000,
          "description": "Milliseconds between checks for local Agent Beacon hook events."
        },
        "peacock.agentBeaconStaleMinutes": {
          "type": "number",
          "default": 480,
          "minimum": 1,
          "maximum": 1440,
          "description": "Minutes before an Agent Beacon event is removed from the Attention Queue."
        },
        "peacock.gitRiskEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Shows a compact status item for conflicts, dirty files, and significant ahead or behind counts. The item stays hidden for a clean repository."
        },
        "peacock.gitRiskAheadBehindThreshold": {
          "type": "number",
          "default": 1,
          "minimum": 1,
          "maximum": 100,
          "description": "Minimum ahead or behind count shown by the Git Risk indicator."
        },
        "peacock.environmentGuardrails": {
          "type": "array",
          "default": [],
          "description": "Optional, explicit environment warnings. Rules match workspace names or paths, remote authorities, branches, or Git remotes; no environments are inferred automatically.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "pattern"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Short label such as Production or Staging."
              },
              "pattern": {
                "type": "string",
                "description": "Case-insensitive glob pattern, for example *prod* or ssh-remote+production-* ."
              },
              "target": {
                "type": "string",
                "default": "any",
                "enum": [
                  "any",
                  "workspace",
                  "remote",
                  "branch",
                  "gitRemote"
                ],
                "description": "Environment identity field to test."
              },
              "severity": {
                "type": "string",
                "default": "warning",
                "enum": [
                  "warning",
                  "error"
                ],
                "description": "Accessible status-bar emphasis used for the warning."
              }
            }
          }
        },
        "peacock.squigglyBeGone": {
          "type": "boolean",
          "default": false,
          "description": "Easter egg! Specifies whether Peacock should hide all red error, warning and info underlines from the editor by making their color the same as the background."
        },
        "peacock.affectEditorGroupBorder": {
          "type": "boolean",
          "default": false,
          "description": "Specifies whether Peacock should affect the editorGroup border."
        },
        "peacock.affectPanelBorder": {
          "type": "boolean",
          "default": false,
          "description": "Specifies whether Peacock should affect the panel border."
        },
        "peacock.affectSideBarBorder": {
          "type": "boolean",
          "default": false,
          "description": "Specifies whether Peacock should affect the sideBar border."
        },
        "peacock.affectSashHover": {
          "type": "boolean",
          "default": true,
          "description": "Specifies whether Peacock should affect the sash border."
        },
        "peacock.affectActivityBar": {
          "type": "boolean",
          "default": true,
          "description": "Specifies whether Peacock should affect the activity bar."
        },
        "peacock.affectDebuggingStatusBar": {
          "type": "boolean",
          "default": false,
          "description": "Specifies whether Peacock should affect the status bar while debugging."
        },
        "peacock.affectStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Specifies whether Peacock should affect the status bar."
        },
        "peacock.affectStatusAndTitleBorders": {
          "type": "boolean",
          "default": false,
          "description": "Specifies whether Peacock should affect the status or title borders."
        },
        "peacock.affectTabActiveBorder": {
          "type": "boolean",
          "default": false,
          "description": "Specifies whether Peacock should affect the active tab's border."
        },
        "peacock.affectTitleBar": {
          "type": "boolean",
          "default": true,
          "description": "Specifies whether Peacock should affect the title bar."
        },
        "peacock.autoColorMode": {
          "type": "string",
          "default": "off",
          "enum": [
            "off",
            "auto",
            "projectIcon",
            "gitRemote",
            "workspace"
          ],
          "enumDescriptions": [
            "Do not derive a color automatically",
            "Try the configured automatic sources in priority order",
            "Extract a color from the project icon or favicon",
            "Derive a deterministic color from the configured Git remote",
            "Derive a deterministic color from the workspace URI"
          ],
          "scope": "resource",
          "description": "Automatically chooses a Peacock color when no manual peacock.color or peacock.remoteColor is set."
        },
        "peacock.autoColorPriority": {
          "type": "array",
          "default": [
            "projectIcon",
            "gitRemote",
            "workspace"
          ],
          "items": {
            "type": "string",
            "enum": [
              "projectIcon",
              "gitRemote",
              "workspace"
            ]
          },
          "uniqueItems": true,
          "description": "Source priority used when peacock.autoColorMode is auto."
        },
        "peacock.gitRemoteName": {
          "type": "string",
          "default": "origin",
          "description": "Git remote whose normalized URL is used for deterministic repository colors."
        },
        "peacock.projectIconPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Optional project-icon path relative to the workspace root. When empty, Peacock searches the configured patterns."
        },
        "peacock.projectIconSearchPatterns": {
          "type": "array",
          "default": [
            "favicon.ico",
            "favicon.png",
            "favicon.svg",
            "public/favicon.ico",
            "public/favicon.png",
            "public/favicon.svg",
            "app/favicon.ico",
            "app/favicon.png",
            "assets/icon.png",
            "assets/app-icon.png",
            "src/assets/icon.png"
          ],
          "items": {
            "type": "string"
          },
          "scope": "resource",
          "description": "Ordered glob patterns used to find an icon or favicon for automatic color extraction."
        },
        "peacock.projectIconPaletteStrategy": {
          "type": "string",
          "default": "dominant",
          "enum": [
            "dominant",
            "vibrant",
            "muted",
            "pastel"
          ],
          "scope": "resource",
          "description": "Color treatment applied after extracting the dominant project-icon color."
        },
        "peacock.projectIconMaxSize": {
          "type": "number",
          "default": 5242880,
          "minimum": 1024,
          "scope": "resource",
          "description": "Maximum project-icon file size in bytes."
        },
        "peacock.branchColors": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string",
            "format": "color"
          },
          "examples": [
            {
              "main": "#d73a49",
              "develop": "#fb8c00",
              "release/*": "#8e44ad"
            }
          ],
          "description": "Branch name or glob pattern to status-bar color. Exact names take priority; for example, use main to warn on a protected branch."
        },
        "peacock.colorBranchStatusItem": {
          "type": "boolean",
          "default": true,
          "description": "Show the current branch in Peacock's status item with a deterministic branch foreground color."
        },
        "peacock.color": {
          "type": "string",
          "format": "color",
          "default": "",
          "description": "The Peacock color that will be applied to workspaces. This should only be set at the workspace level."
        },
        "peacock.elementAdjustments": {
          "type": "object",
          "properties": {
            "titleBar": {
              "type": "string",
              "enum": [
                "none",
                "lighten",
                "darken"
              ]
            },
            "activityBar": {
              "type": "string",
              "enum": [
                "none",
                "lighten",
                "darken"
              ]
            },
            "statusBar": {
              "type": "string",
              "enum": [
                "none",
                "lighten",
                "darken"
              ]
            }
          },
          "default": {
            "activityBar": "lighten",
            "statusBar": "none",
            "titleBar": "none"
          },
          "description": "Adjusts the colorization of affected elements to provide visual contrast"
        },
        "peacock.favoriteColors": {
          "type": "array",
          "default": [
            {
              "name": "Angular Red",
              "value": "#dd0531"
            },
            {
              "name": "Azure Blue",
              "value": "#007fff"
            },
            {
              "name": "JavaScript Yellow",
              "value": "#f9e64f"
            },
            {
              "name": "Mandalorian Blue",
              "value": "#1857a4"
            },
            {
              "name": "Node Green",
              "value": "#215732"
            },
            {
              "name": "React Blue",
              "value": "#61dafb"
            },
            {
              "name": "Something Different",
              "value": "#832561"
            },
            {
              "name": "Svelte Orange",
              "value": "#ff3d00"
            },
            {
              "name": "Vue Green",
              "value": "#42b883"
            }
          ],
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {
                "type": "string",
                "format": "color"
              }
            }
          },
          "description": "Your favorite colors"
        },
        "peacock.keepBadgeColor": {
          "type": "boolean",
          "default": false,
          "description": "Recommended to remain false. However, when set to true Peacock will not colorize badges in any of the affected elements in response to background alterations"
        },
        "peacock.darkenLightenPercentage": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 10,
          "description": "Specifies the amount to darken or lighten the color, in percentage"
        },
        "peacock.darkForegroundColor": {
          "type": "string",
          "format": "color",
          "default": "#15202b",
          "description": "Specifies the override value for the dark foreground color"
        },
        "peacock.keepForegroundColor": {
          "type": "boolean",
          "default": false,
          "description": "Recommended to remain false. However, when set to true Peacock will not colorize the foreground of any of the affected elements and will only alter the background"
        },
        "peacock.lightForegroundColor": {
          "type": "string",
          "format": "color",
          "default": "#e7e7e7",
          "description": "Specifies the override value for the light foreground color"
        },
        "peacock.remoteColor": {
          "type": "string",
          "format": "color",
          "default": "",
          "description": "The Peacock color that will be applied to remote workspaces."
        },
        "peacock.showColorInStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the Peacock color in the status bar"
        },
        "peacock.surpriseMeFromFavoritesOnly": {
          "type": "boolean",
          "default": false,
          "description": "Specifies whether Peacock should choose a random color from the favorites list or a purely random color."
        },
        "peacock.surpriseMeOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "Specifies that Peacock should surprise you at the start of every editing session, only when a color isn't already set. "
        },
        "peacock.vslsJoinColor": {
          "type": "string",
          "format": "color",
          "default": "",
          "description": "Peacock color for Live Share Color when acting as a Guest "
        },
        "peacock.vslsShareColor": {
          "type": "string",
          "format": "color",
          "default": "",
          "description": "Peacock color for Live Share Color when acting as a Host "
        }
      }
    }
  },
  "scripts": {
    "package": "npx vsce package",
    "publish": "npx vsce publish",
    "vscode:prepublish": "webpack --mode production",
    "lint": "eslint ./src --ext .js,.ts",
    "lint-fix": "eslint ./src --ext .js,.ts --fix",
    "webpack": "webpack --mode none",
    "watch": "webpack --mode none --watch",
    "pretty": "npx prettier@2 src/. --write",
    "just-test": "node ./out/test/runTest.js",
    "just-live-share-test": "node out/live-share/test/runTest.js",
    "test-compile": "tsc -p ./ && npm run webpack",
    "test": "npm run test-compile && npm run just-test",
    "test-all": "npm run test && npm run just-live-share-test",
    "test:coverage": "npm run just-test -- --coverage",
    "open-in-browser": "npx vscode-test-web --browserType=chromium --extensionDevelopmentPath=. .",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/glob": "^7.1.3",
    "@types/istanbul-lib-instrument": "^1.7.4",
    "@types/istanbul-lib-report": "^1.1.1",
    "@types/istanbul-lib-source-maps": "^1.2.2",
    "@types/istanbul-reports": "^1.1.2",
    "@types/mocha": "^7.0.2",
    "@types/node": "12.12.16",
    "@types/sinon": "^7.5.2",
    "@types/vscode": "~1.61.0",
    "@types/upng-js": "^2.1.5",
    "@types/webpack-env": "^1.18.8",
    "@typescript-eslint/eslint-plugin": "^2.34.0",
    "@typescript-eslint/parser": "^2.34.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/test-web": "^0.0.80",
    "eslint": "^6.8.0",
    "eslint-config-prettier": "^6.12.0",
    "eslint-plugin-prettier": "^3.1.4",
    "glob": "^7.1.6",
    "husky": "^4.3.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-instrument": "^3.3.0",
    "istanbul-lib-report": "^2.0.8",
    "istanbul-lib-source-maps": "^3.0.6",
    "istanbul-reports": "^3.0.2",
    "mocha": "^11.7.5",
    "mocha-multi-reporters": "^1.1.7",
    "prettier": "^2.1.2",
    "process": "^0.11.10",
